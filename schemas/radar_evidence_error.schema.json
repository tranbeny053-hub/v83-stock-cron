{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-crypto-probability-engine.local/schemas/radar_evidence_error.schema.json",
  "title": "radar_evidence_error.v1",
  "description": "Every non-200 body of POST /v1/automation/radar-evidence, sent as its RFC 8785 JCS bytes. It never carries a credential, a request field, user data or partial evidence: the code is from a fixed catalogue and the message is that code's fixed text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "radar_evidence_error.v1"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retry_after_seconds"
      ],
      "properties": {
        "code": {
          "enum": [
            "MALFORMED_REQUEST",
            "CREDENTIAL_REQUIRED",
            "CREDENTIAL_INVALID",
            "HUMAN_SESSION_REFUSED",
            "IDEMPOTENCY_CONFLICT",
            "REQUEST_IN_PROGRESS",
            "UNSUPPORTED_SYMBOL",
            "UNSUPPORTED_TIMEFRAME",
            "QUOTA_EXCEEDED",
            "CONCURRENCY_LIMIT",
            "AUTOMATION_DISABLED",
            "NOT_CONFIGURED",
            "LEDGER_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "UPSTREAM_UNAVAILABLE",
            "ANALYSIS_FAILED",
            "CONTRACT_VIOLATION"
          ]
        },
        "message": {
          "enum": [
            "A machine credential is required.",
            "An automated analysis is already running.",
            "Human sessions are not accepted on this route.",
            "Market data is unavailable.",
            "The analysis could not be completed.",
            "The automation ledger is unavailable.",
            "The automation route is disabled.",
            "The automation route is not configured.",
            "The credential's quota is exhausted.",
            "The deadline passed before evidence was ready.",
            "The evidence failed its contract and was withheld.",
            "The machine credential was refused.",
            "The primary_timeframe is not supported.",
            "The request body is not a valid radar-evidence request.",
            "The symbol is not supported.",
            "This client_request_id is still being processed.",
            "This client_request_id was already used for a different request."
          ]
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
