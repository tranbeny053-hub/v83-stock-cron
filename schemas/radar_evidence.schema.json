{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-crypto-probability-engine.local/schemas/radar_evidence.schema.json",
  "title": "radar_evidence.v1",
  "description": "The success body of POST /v1/automation/radar-evidence. Strict: unknown fields are refused at every level. Values are read from UCPE's governed analysis, never recomputed. Shadow blocks are omitted. Any breaking or semantic change is a new version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_origin",
    "client_request_id",
    "run_id",
    "analysis_hash",
    "analysis_schema_version",
    "as_of_utc",
    "issued_at_utc",
    "symbol",
    "normalized_symbol",
    "primary_timeframe",
    "horizon",
    "build_info",
    "probability_state",
    "calibration_state",
    "gate_result",
    "decision_brief",
    "frontend_display",
    "data_quality",
    "determinism",
    "evidence_hash"
  ],
  "properties": {
    "schema_version": {"const": "radar_evidence.v1"},
    "evidence_origin": {"const": "AUTOMATED_RADAR"},
    "client_request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "analysis_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "analysis_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "as_of_utc": {"$ref": "#/$defs/utc_instant"},
    "issued_at_utc": {"$ref": "#/$defs/utc_instant"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "normalized_symbol": {"type": "string", "minLength": 1, "maxLength": 32},
    "primary_timeframe": {"enum": ["15m", "1H", "4H", "1D"]},
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bars", "label"],
      "properties": {
        "bars": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "build_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_id",
        "release_label",
        "environment",
        "source_milestone",
        "fingerprint"
      ],
      "properties": {
        "schema_version": {"type": "string", "pattern": "^build-info\\.v[1-9][0-9]*$"},
        "release_id": {"type": "string", "pattern": "^UCPE-[A-Z0-9-]{3,}$"},
        "release_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "environment": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_milestone": {"type": "string", "minLength": 1, "maxLength": 64},
        "fingerprint": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "probability_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability_type", "calibration_status", "horizons"],
      "properties": {
        "probability_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "calibration_status": {"type": "string", "minLength": 1, "maxLength": 64},
        "horizons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["H_primary", "H_extended"],
          "properties": {
            "H_primary": {"$ref": "#/$defs/horizon_probabilities"},
            "H_extended": {"$ref": "#/$defs/horizon_probabilities"}
          }
        }
      }
    },
    "calibration_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_status", "reliability_status", "profitability_claim", "reason"],
      "properties": {
        "calibration_status": {"type": "string", "minLength": 1, "maxLength": 64},
        "reliability_status": {"type": "string", "minLength": 1, "maxLength": 64},
        "profitability_claim": {"const": false},
        "reason": {"type": "string", "maxLength": 512}
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_gate_passed", "hard_blocks", "directional_evidence_hold"],
      "properties": {
        "hard_gate_passed": {"type": "boolean"},
        "hard_blocks": {"$ref": "#/$defs/codes"},
        "directional_evidence_hold": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["active", "hold_reason"],
              "properties": {
                "active": {"const": true},
                "hold_reason": {"type": "string", "minLength": 1, "maxLength": 64}
              }
            }
          ]
        }
      }
    },
    "decision_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "hard_blockers", "model_readiness", "reliability_status", "profitability_claim"],
      "properties": {
        "action": {"type": "string", "minLength": 1, "maxLength": 64},
        "hard_blockers": {"$ref": "#/$defs/codes"},
        "model_readiness": {"type": "string", "minLength": 1, "maxLength": 64},
        "reliability_status": {"type": "string", "minLength": 1, "maxLength": 64},
        "profitability_claim": {"const": false}
      }
    },
    "frontend_display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_live_data", "disposition"],
      "properties": {
        "is_live_data": {"type": "boolean"},
        "disposition": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "is_live_data", "data_source", "cross_provider_state"],
      "properties": {
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "is_live_data": {"type": "boolean"},
        "data_source": {"type": ["string", "null"], "maxLength": 64},
        "cross_provider_state": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "live_repeat_reproducible"],
      "properties": {
        "basis": {"const": "CANONICAL_INPUTS_AND_RELEASE"},
        "live_repeat_reproducible": {"const": false}
      }
    },
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "utc_instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "codes": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]{1,64}$"}
    },
    "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "horizon_probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "null_reason",
        "p_up_frac",
        "p_down_frac",
        "p_timeout_frac",
        "confidence_frac",
        "sample_count",
        "sample_count_basis"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "null_reason": {"type": ["string", "null"], "maxLength": 256},
        "p_up_frac": {"$ref": "#/$defs/probability"},
        "p_down_frac": {"$ref": "#/$defs/probability"},
        "p_timeout_frac": {"$ref": "#/$defs/probability"},
        "confidence_frac": {"$ref": "#/$defs/probability"},
        "sample_count": {"type": "null"},
        "sample_count_basis": {"const": "NONE_UNCALIBRATED_HEURISTIC"}
      }
    }
  }
}
